+        var image=new BufferedImage(charSize,charSize,BufferedImage.TYPE_INT_ARGB);
+        var g=image.createGraphics();g.setFont(font);
+        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
